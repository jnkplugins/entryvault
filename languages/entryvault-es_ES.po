#: pro/licensorpro-client/licensorpro-client.php:751
msgid "Manage license"
msgstr "Gestionar licencia"

#: pro/licensorpro-client/licensorpro-client.php:754
msgid "Renew license"
msgstr "Renovar licencia"

#: pro/licensorpro-client/licensorpro-client.php:755
msgid "Activate license"
msgstr "Activar licencia"

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:782
#, php-format
msgid ""
"<strong>%s Pro is on.</strong> Thank you! Every Pro tool is switched on for "
"this site, and updates come to your dashboard."
msgstr ""
"<strong>%s Pro está activado.</strong> ¡Gracias! Todas las herramientas Pro "
"están activadas en este sitio y las actualizaciones llegan a tu escritorio."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:831
#, php-format
msgid ""
"<strong>%s Pro is installed, but no Pro license is active on this site.</"
"strong> Enter your license key to switch on the Pro tools."
msgstr ""
"<strong>%s Pro está instalado, pero no hay ninguna licencia Pro activa en "
"este sitio.</strong> Introduce tu clave de licencia para activar las "
"herramientas Pro."

#: pro/licensorpro-client/licensorpro-client.php:837
msgid "Enter license key"
msgstr "Introducir clave de licencia"

#: pro/licensorpro-client/licensorpro-client.php:840
msgid "Find your key in your account"
msgstr "Busca tu clave en tu cuenta"

#: pro/licensorpro-client/licensorpro-client.php:866
msgid "Renew your license"
msgstr "Renueva tu licencia"

#. translators: 1: plugin name, 2: expiry date, 3: lock date, 4: days left
#: pro/licensorpro-client/licensorpro-client.php:872
#, php-format
msgid ""
"<strong>Your %1$s Pro license expired on %2$s.</strong> Pro keeps working as "
"normal until %3$s (%4$d days left). Updates, including security fixes, and "
"email support have stopped. After %3$s, everything you already set up keeps "
"working and your visitors won't notice a thing, but the Pro tools in your "
"dashboard will lock."
msgstr ""
"<strong>Tu licencia de %1$s Pro caducó el %2$s.</strong> Pro sigue "
"funcionando con normalidad hasta el %3$s (quedan %4$d días). Las "
"actualizaciones, incluidas las de seguridad, y el soporte por correo se han "
"detenido. Después del %3$s, todo lo que ya configuraste sigue funcionando y "
"tus visitantes no notarán nada, pero las herramientas Pro de tu escritorio "
"se bloquearán."

#. translators: 1: plugin name, 2: expiry date
#: pro/licensorpro-client/licensorpro-client.php:882
#, php-format
msgid ""
"<strong>%1$s Pro tools are locked because your license expired on %2$s.</"
"strong> Your site, and everything visitors see, still works. Renew to unlock "
"the Pro tools and get updates, including security fixes, again."
msgstr ""
"<strong>Las herramientas de %1$s Pro están bloqueadas porque tu licencia "
"caducó el %2$s.</strong> Tu sitio, y todo lo que ven los visitantes, sigue "
"funcionando. Renueva para desbloquear las herramientas Pro y volver a "
"recibir actualizaciones, incluidas las de seguridad."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:890
#, php-format
msgid ""
"<strong>This site is no longer activated on your %s Pro license.</strong> "
"The Pro tools in your dashboard are locked until you activate it again. "
"Everything visitors see keeps working."
msgstr ""
"<strong>Este sitio ya no está activado en tu licencia de %s Pro.</strong> "
"Las herramientas Pro de tu escritorio están bloqueadas hasta que lo vuelvas "
"a activar. Todo lo que ven los visitantes sigue funcionando."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:897
#, php-format
msgid ""
"<strong>Your %s Pro license is no longer active.</strong> It was refunded or "
"cancelled, so the Pro tools in your dashboard are locked and updates have "
"stopped. Everything visitors see keeps working."
msgstr ""
"<strong>Tu licencia de %s Pro ya no está activa.</strong> Se reembolsó o se "
"canceló, así que las herramientas Pro de tu escritorio están bloqueadas y "
"las actualizaciones se han detenido. Todo lo que ven los visitantes sigue "
"funcionando."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:906
#, php-format
msgid "Your %s Pro license is no longer active on this site."
msgstr "Tu licencia Pro de %s ya no está activa en este sitio."

#: pro/licensorpro-client/licensorpro-client.php:1010
msgid "Please enter a license key."
msgstr "Introduce una clave de licencia."

#: pro/licensorpro-client/licensorpro-client.php:1025
#: pro/licensorpro-client/licensorpro-client.php:1085
msgid "License response failed signature verification."
msgstr ""
"La respuesta de la licencia no ha superado la verificación de la firma."

#: pro/licensorpro-client/licensorpro-client.php:1067
msgid "No license key set."
msgstr "No hay ninguna clave de licencia."

#: pro/licensorpro-client/licensorpro-client.php:1200
msgid "Only deactivating temporarily"
msgstr "Solo lo desactivo temporalmente"

#: pro/licensorpro-client/licensorpro-client.php:1201
msgid "I could not work out how to use it"
msgstr "No supe cómo usarlo"

#: pro/licensorpro-client/licensorpro-client.php:1202
msgid "It is missing a feature I need"
msgstr "Le falta una función que necesito"

#: pro/licensorpro-client/licensorpro-client.php:1203
msgid "It did not work"
msgstr "No funcionó"

#: pro/licensorpro-client/licensorpro-client.php:1204
msgid "It broke something on my site"
msgstr "Rompió algo en mi sitio"

#: pro/licensorpro-client/licensorpro-client.php:1205
msgid "I found a better plugin"
msgstr "Encontré un plugin mejor"

#: pro/licensorpro-client/licensorpro-client.php:1206
msgid "I no longer need it"
msgstr "Ya no lo necesito"

#: pro/licensorpro-client/licensorpro-client.php:1207
msgid "Something else"
msgstr "Otro motivo"

#. translators: %s: plugin name.
#: pro/licensorpro-client/licensorpro-client.php:1234
#, php-format
msgid "Before you turn %s off"
msgstr "Antes de desactivar %s"

#: pro/licensorpro-client/licensorpro-client.php:1238
msgid ""
"If you have a moment, what went wrong? It is the only way we hear about it."
msgstr ""
"Si tienes un momento, ¿qué ha fallado? Es la única forma de que nos "
"enteremos."

#: pro/licensorpro-client/licensorpro-client.php:1249
msgid "Anything else? (optional)"
msgstr "¿Algo más? (opcional)"

#: pro/licensorpro-client/licensorpro-client.php:1251
msgid ""
"Sends your answer, the plugin version and your site address. Nothing else, "
"and nothing from your site content."
msgstr ""
"Envía tu respuesta, la versión del plugin y la dirección de tu sitio. Nada "
"más, y nada del contenido de tu sitio."

#: pro/licensorpro-client/licensorpro-client.php:1255
msgid "Send and deactivate"
msgstr "Enviar y desactivar"

#: pro/licensorpro-client/licensorpro-client.php:1258
msgid "Skip and deactivate"
msgstr "Omitir y desactivar"

#: pro/licensorpro-client/licensorpro-client.php:1261 admin/views/tags.php:54
#: admin/assets/kanban/build/index.js:3 admin/assets/kanban/build/index.js:24
msgid "Cancel"
msgstr "Cancelar"

#: pro/licensorpro-client/licensorpro-client.php:1392
#: pro/licensorpro-client/licensorpro-client.php:1408
msgid "API URL not configured."
msgstr "La URL de la API no está configurada."

#: pro/licensorpro-client/licensorpro-client.php:1427
msgid "Unexpected response from license server."
msgstr "Respuesta inesperada del servidor de licencias."

#. translators: %s: human-readable time difference, e.g. "3 hours".
#: pro/licensorpro-client/licensorpro-client.php:1758
#: includes/class-dates.php:67
#, php-format
msgid "in %s"
msgstr "dentro de %s"

#. translators: %s: human-readable time difference, e.g. "3 hours".
#: pro/licensorpro-client/licensorpro-client.php:1759
#: includes/class-dates.php:75
#, php-format
msgid "%s ago"
msgstr "hace %s"

#: pro/licensorpro-client/licensorpro-client.php:1775
#, php-format
msgid "%s License"
msgstr "Licencia de %s"

#: pro/licensorpro-client/licensorpro-client.php:1785
msgid ""
"This site was deactivated, so its seat is free for another site. Enter the "
"key again here to switch the Pro tools back on."
msgstr ""
"Este sitio se desactivó, así que su plaza queda libre para otro sitio. "
"Vuelve a introducir la clave aquí para activar de nuevo las herramientas Pro."

#: pro/licensorpro-client/licensorpro-client.php:1803
#: pro/licensorpro-client/licensorpro-client.php:2351
msgid "Enter your license key first."
msgstr "Primero introduce tu clave de licencia."

#: pro/licensorpro-client/licensorpro-client.php:1804
msgid "Installing Pro. This takes a few seconds, keep this page open…"
msgstr "Instalando Pro. Tarda unos segundos, mantén esta página abierta…"

#: pro/licensorpro-client/licensorpro-client.php:1805
msgid "Reloading to switch on the Pro tools…"
msgstr "Recargando para activar las herramientas Pro…"

#: pro/licensorpro-client/licensorpro-client.php:1806
msgid "Reload now"
msgstr "Recargar ahora"

#: pro/licensorpro-client/licensorpro-client.php:1807
msgid ""
"Could not reach the licensing server. Check your connection and try again."
msgstr ""
"No se pudo conectar con el servidor de licencias. Comprueba tu conexión y "
"vuelve a intentarlo."

#: pro/licensorpro-client/licensorpro-client.php:1808
msgid ""
"Deactivate this license on this site? Premium features switch off here and "
"the seat is freed for another site."
msgstr ""
"¿Desactivar esta licencia en este sitio? Las funciones premium se apagan "
"aquí y el hueco queda libre para otro sitio."

#: pro/licensorpro-client/licensorpro-client.php:1809
#: includes/class-plugin.php:403
msgid "Done."
msgstr "Hecho."

#: pro/licensorpro-client/licensorpro-client.php:1810
msgid "Deactivated."
msgstr "Desactivado."

#: pro/licensorpro-client/licensorpro-client.php:1811
msgid "Checked."
msgstr "Comprobado."

#: pro/licensorpro-client/licensorpro-client.php:1982
#: pro/licensorpro-client/licensorpro-client.php:2013
#: pro/licensorpro-client/licensorpro-client.php:2088
msgid "License key"
msgstr "Clave de licencia"

#: pro/licensorpro-client/licensorpro-client.php:1983
msgid "Type"
msgstr "Tipo"

#: pro/licensorpro-client/licensorpro-client.php:1985
msgid ""
"Free license: updates of the free version only. It does not switch on Pro."
msgstr ""
"Licencia gratuita: solo actualizaciones de la versión gratuita. No activa "
"Pro."

#: pro/licensorpro-client/licensorpro-client.php:1986
msgid "Free license: updates arrive in your dashboard like any other plugin."
msgstr ""
"Licencia gratuita: las actualizaciones llegan a tu escritorio como las de "
"cualquier otro plugin."

#: pro/licensorpro-client/licensorpro-client.php:1988
#: pro/licensorpro-client/licensorpro-client.php:2056
msgid "Last checked"
msgstr "Última comprobación"

#: pro/licensorpro-client/licensorpro-client.php:1992
#: pro/licensorpro-client/licensorpro-client.php:2062
msgid "Check for updates now"
msgstr "Buscar actualizaciones ahora"

#: pro/licensorpro-client/licensorpro-client.php:1995
msgid "Bought Pro?"
msgstr "¿Compraste Pro?"

#: pro/licensorpro-client/licensorpro-client.php:1996
msgid ""
"Enter your Pro license key and Pro is installed over this version. "
"Everything you set up stays."
msgstr ""
"Introduce tu clave de licencia Pro y Pro se instala sobre esta versión. Todo "
"lo que configuraste se mantiene."

#: pro/licensorpro-client/licensorpro-client.php:1998
msgid "Pro license key"
msgstr "Clave de licencia Pro"

#: pro/licensorpro-client/licensorpro-client.php:2001
#: pro/licensorpro-client/licensorpro-client.php:2069
msgid "Install Pro now"
msgstr "Instalar Pro ahora"

#: pro/licensorpro-client/licensorpro-client.php:2003
msgid ""
"Rather do it by hand? Download the Pro zip from your account and upload it "
"over this plugin."
msgstr ""
"¿Prefieres hacerlo a mano? Descarga el zip de Pro desde tu cuenta y súbelo "
"sobre este plugin."

#: pro/licensorpro-client/licensorpro-client.php:2004
#: pro/licensorpro-client/licensorpro-client.php:2096
msgid "Go to your account"
msgstr "Ir a tu cuenta"

#: pro/licensorpro-client/licensorpro-client.php:2017
msgid "this site is not activated"
msgstr "este sitio no está activado"

#: pro/licensorpro-client/licensorpro-client.php:2018
msgid "this key is for a different plugin"
msgstr "esta clave es de otro plugin"

#: pro/licensorpro-client/licensorpro-client.php:2019
msgid "key not recognised"
msgstr "clave no reconocida"

#: pro/licensorpro-client/licensorpro-client.php:2020
#: pro/licensorpro-client/licensorpro-client.php:2021
msgid "revoked"
msgstr "revocada"

#: pro/licensorpro-client/licensorpro-client.php:2025
msgid "active"
msgstr "activa"

#. translators: %s: date the Pro tools lock
#: pro/licensorpro-client/licensorpro-client.php:2027
#, php-format
msgid "expired, Pro tools stay on until %s"
msgstr "caducada, las herramientas Pro siguen activas hasta el %s"

#: pro/licensorpro-client/licensorpro-client.php:2028
msgid "expired, Pro tools locked"
msgstr "caducada, herramientas Pro bloqueadas"

#: pro/licensorpro-client/licensorpro-client.php:2029
msgid "no longer active (refunded or cancelled)"
msgstr "ya no está activa (reembolsada o cancelada)"

#. translators: %s: date the Pro tools lock
#: pro/licensorpro-client/licensorpro-client.php:2033
#, php-format
msgid "renewal payment failed, Pro tools stay on until %s"
msgstr ""
"falló el pago de renovación, las herramientas Pro siguen activas hasta el %s"

#: pro/licensorpro-client/licensorpro-client.php:2035
#: admin/views/past-entries.php:91 includes/class-export.php:51
#: admin/assets/kanban/build/index.js:3
msgid "Status"
msgstr "Estado"

#: pro/licensorpro-client/licensorpro-client.php:2037
msgid "Renew"
msgstr "Renovar"

#: pro/licensorpro-client/licensorpro-client.php:2041
msgid "Offline mode"
msgstr "Modo sin conexión"

#: pro/licensorpro-client/licensorpro-client.php:2043
#, php-format
msgid "cached license valid until %s"
msgstr "licencia en caché válida hasta el %s"

#: pro/licensorpro-client/licensorpro-client.php:2048
msgctxt "update channel"
msgid "stable"
msgstr "estable"

#: pro/licensorpro-client/licensorpro-client.php:2049
msgctxt "update channel"
msgid "beta"
msgstr "beta"

#: pro/licensorpro-client/licensorpro-client.php:2050
msgctxt "update channel"
msgid "release candidate"
msgstr "versión candidata"

#: pro/licensorpro-client/licensorpro-client.php:2051
msgctxt "update channel"
msgid "development"
msgstr "desarrollo"

#: pro/licensorpro-client/licensorpro-client.php:2053
msgid "Update channel"
msgstr "Canal de actualizaciones"

#: pro/licensorpro-client/licensorpro-client.php:2054
msgid "Site limit"
msgstr "Límite de sitios"

#: pro/licensorpro-client/licensorpro-client.php:2054
msgid "Unlimited"
msgstr "Ilimitado"

#: pro/licensorpro-client/licensorpro-client.php:2055
msgid "Expires"
msgstr "Caduca"

#: pro/licensorpro-client/licensorpro-client.php:2055
msgid "Never"
msgstr "Nunca"

#: pro/licensorpro-client/licensorpro-client.php:2060
msgid "Deactivate this site"
msgstr "Desactivar este sitio"

#: pro/licensorpro-client/licensorpro-client.php:2067
msgid "This is the free version, running on your Pro license."
msgstr "Esta es la versión gratuita, funcionando con tu licencia Pro."

#: pro/licensorpro-client/licensorpro-client.php:2084
msgid ""
"Have a Pro license key? Enter it here to switch on the Pro tools. It "
"replaces the free license on this site."
msgstr ""
"¿Tienes una clave de licencia Pro? Introdúcela aquí para activar las "
"herramientas Pro. Sustituye a la licencia gratuita en este sitio."

#: pro/licensorpro-client/licensorpro-client.php:2085
msgid "Enter your license key to activate this site."
msgstr "Introduce tu clave de licencia para activar este sitio."

#: pro/licensorpro-client/licensorpro-client.php:2092
msgid "Activate"
msgstr "Activar"

#: pro/licensorpro-client/licensorpro-client.php:2095
msgid "Your key is in your purchase email and in your account."
msgstr "Tu clave está en el correo de tu compra y en tu cuenta."

#: pro/licensorpro-client/licensorpro-client.php:2103
msgid "Need a hand?"
msgstr "¿Necesitas ayuda?"

#: pro/licensorpro-client/licensorpro-client.php:2104
msgid "Contact support"
msgstr "Contactar con soporte"

#: pro/licensorpro-client/licensorpro-client.php:2151
msgid "Only someone who may install plugins on this site can install Pro."
msgstr ""
"Solo alguien que pueda instalar plugins en este sitio puede instalar Pro."

#: pro/licensorpro-client/licensorpro-client.php:2164
msgid ""
"That is a free license key, so it keeps this free version updated. Pro needs "
"the key from your purchase email."
msgstr ""
"Esa es una clave de licencia gratuita, así que mantiene actualizada esta "
"versión gratuita. Pro necesita la clave del correo de tu compra."

#. translators: %s: URL of the customer account
#: pro/licensorpro-client/licensorpro-client.php:2169
#, php-format
msgid ""
"Your key is active. Download the Pro zip from your account (%s) and upload "
"it over this plugin instead."
msgstr ""
"Tu clave está activa. Descarga el zip de Pro desde tu cuenta (%s) y súbelo "
"sobre este plugin."

#: pro/licensorpro-client/licensorpro-client.php:2173
msgid "This site does not allow installing plugins from the dashboard."
msgstr "Este sitio no permite instalar plugins desde el escritorio."

#: pro/licensorpro-client/licensorpro-client.php:2177
msgid "The Pro download could not be fetched for this key."
msgstr "No se pudo obtener la descarga de Pro para esta clave."

#: pro/licensorpro-client/licensorpro-client.php:2185
msgid "This site asks for FTP details to install plugins."
msgstr "Este sitio pide datos de FTP para instalar plugins."

#: pro/licensorpro-client/licensorpro-client.php:2220
msgid "Installing Pro did not finish."
msgstr "La instalación de Pro no terminó."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:2225
#, php-format
msgid "%s Pro is installed and your license is active. Reloading…"
msgstr "%s Pro está instalado y tu licencia está activa. Recargando…"

#: pro/licensorpro-client/licensorpro-client.php:2244
msgid "License activated."
msgstr "Licencia activada."

#: pro/licensorpro-client/licensorpro-client.php:2256
msgid "Site deactivated."
msgstr "Sitio desactivado."

#: pro/licensorpro-client/licensorpro-client.php:2278
msgid "License is valid. Update info refreshed."
msgstr "La licencia es válida. Información de actualizaciones renovada."

#: pro/licensorpro-client/licensorpro-client.php:2312
msgid ""
"Every seat on this license is in use. Deactivate one of your other sites "
"from your account, then try again."
msgstr ""
"Todos los sitios de esta licencia están en uso. Desactiva uno de tus otros "
"sitios desde tu cuenta y vuelve a intentarlo."

#: pro/licensorpro-client/licensorpro-client.php:2315
msgid ""
"This license has expired. Renewing it from your account reactivates this "
"site immediately. Your settings and data are untouched."
msgstr ""
"Esta licencia ha caducado. Al renovarla desde tu cuenta, este sitio se "
"reactiva al momento. Tus ajustes y datos no se tocan."

#: pro/licensorpro-client/licensorpro-client.php:2317
msgid ""
"The last renewal payment for this license did not go through, so it is "
"paused. Update your payment details in your account and it switches back on. "
"Your settings and data are untouched."
msgstr ""
"El último pago de renovación de esta licencia no se completó, así que está "
"en pausa. Actualiza tus datos de pago en tu cuenta y se volverá a activar. "
"Tus ajustes y datos no se tocan."

#: pro/licensorpro-client/licensorpro-client.php:2320
msgid ""
"This license was cancelled or refunded, so it no longer switches on Pro. If "
"that is a mistake, reply to your purchase email."
msgstr ""
"Esta licencia se canceló o se reembolsó, así que ya no activa Pro. Si es un "
"error, responde a tu correo de compra."

#: pro/licensorpro-client/licensorpro-client.php:2323
msgid ""
"That key was not recognised. Check for a missing character, or copy it again "
"from your purchase email."
msgstr ""
"No reconocemos esa clave. Comprueba que no falte ningún carácter o vuelve a "
"copiarla del correo de tu compra."

#: pro/licensorpro-client/licensorpro-client.php:2325
msgid ""
"This key is for a different plugin. Each plugin has its own key: use the one "
"from the purchase email for this plugin."
msgstr ""
"Esta clave es de otro plugin. Cada plugin tiene su propia clave: usa la del "
"correo de compra de este plugin."

#: pro/licensorpro-client/licensorpro-client.php:2328
msgid ""
"This key has been revoked. If you believe that is a mistake, reply to your "
"purchase email and we will sort it out."
msgstr ""
"Esta clave se ha revocado. Si crees que es un error, responde al correo de "
"tu compra y lo solucionamos."

#: pro/licensorpro-client/licensorpro-client.php:2330
msgid ""
"This site is not activated on this license any more. Enter the key again to "
"activate it."
msgstr ""
"Este sitio ya no está activado con esta licencia. Vuelve a introducir la "
"clave para activarlo."

#: pro/licensorpro-client/licensorpro-client.php:2332
msgid ""
"That is a free license key. It keeps the free version updated but does not "
"switch on Pro. Enter the Pro key from your purchase email."
msgstr ""
"Esa es una clave de licencia gratuita. Mantiene actualizada la versión "
"gratuita, pero no activa Pro. Introduce la clave Pro de tu correo de compra."

#: pro/licensorpro-client/licensorpro-client.php:2335
msgid "This plugin has no free license. Use the key from your purchase email."
msgstr ""
"Este plugin no tiene licencia gratuita. Usa la clave de tu correo de compra."

#: pro/licensorpro-client/licensorpro-client.php:2337
msgid ""
"The licensing server does not know this plugin. Update the plugin, or reply "
"to your purchase email."
msgstr ""
"El servidor de licencias no reconoce este plugin. Actualiza el plugin o "
"responde a tu correo de compra."

#: pro/licensorpro-client/licensorpro-client.php:2339
msgid ""
"This site's license session ran out. Check the license again to renew it."
msgstr ""
"La sesión de licencia de este sitio ha caducado. Vuelve a comprobar la "
"licencia para renovarla."

#: pro/licensorpro-client/licensorpro-client.php:2342
msgid ""
"The download link has expired. Check for updates again to get a fresh one."
msgstr ""
"El enlace de descarga ha caducado. Vuelve a buscar actualizaciones para "
"obtener uno nuevo."

#: pro/licensorpro-client/licensorpro-client.php:2344
msgid ""
"The download is not on the server right now. Try again later, or download "
"the zip from your account."
msgstr ""
"La descarga no está en el servidor ahora mismo. Inténtalo más tarde o "
"descarga el zip desde tu cuenta."

#: pro/licensorpro-client/licensorpro-client.php:2346
msgid "Enter a valid email address."
msgstr "Introduce una dirección de correo válida."

#: pro/licensorpro-client/licensorpro-client.php:2349
msgid ""
"The request to the licensing server was missing details. Reload this page "
"and try again."
msgstr ""
"A la solicitud al servidor de licencias le faltaban datos. Recarga esta "
"página e inténtalo de nuevo."

#: pro/licensorpro-client/licensorpro-client.php:2353
msgid ""
"The answer from the licensing server could not be verified, so it was not "
"trusted. Try again in a few minutes. If it keeps happening, reply to your "
"purchase email."
