#: admin/assets/kanban/build/index.js:37
msgid "Clear"
msgstr "साफ़ करें"

#: admin/assets/kanban/build/index.js:37
msgid "The move failed, so the card went back."
msgstr "कार्ड ले जाना विफल रहा, इसलिए कार्ड वापस आ गया।"

#: admin/assets/kanban/build/index.js:37
msgid "No cards on this pipeline."
msgstr "इस पाइपलाइन पर कोई कार्ड नहीं।"

#: admin/assets/kanban/build/index.js:37
msgid ""
"Your entries are on other pipelines. Open one below, or pick it in the "
"Pipeline menu above."
msgstr ""
"आपकी एंट्रियाँ दूसरी पाइपलाइन पर हैं। नीचे से कोई एक खोलें, या ऊपर पाइपलाइन मेन्यू में उसे "
"चुनें।"

#. translators: 1: pipeline name, 2: number of cards on it.
#: admin/assets/kanban/build/index.js:37
msgid "%1$s: %2$d card"
msgid_plural "%1$s: %2$d cards"
msgstr[0] "%1$s: %2$d कार्ड"
msgstr[1] "%1$s: %2$d कार्ड"

#: admin/assets/kanban/build/index.js:37
msgid "Nothing here yet. That is expected."
msgstr "यहाँ अभी कुछ नहीं है। ऐसा होना स्वाभाविक है।"

#: admin/assets/kanban/build/index.js:37
msgid ""
"EntryVault picks up submissions from the form plugins you already use. There "
"is nothing to add to your forms: submit one of them once and it appears on "
"this board within moments."
msgstr ""
"EntryVault उन फ़ॉर्म प्लगइन्स से सबमिशन लेता है जो आप पहले से इस्तेमाल करते हैं। आपके फ़ॉर्म "
"में कुछ जोड़ने की ज़रूरत नहीं है: किसी एक फ़ॉर्म को एक बार भेजें, वह कुछ ही पलों में इस बोर्ड "
"पर दिख जाएगा।"

#: admin/assets/kanban/build/index.js:37
msgid "Check which form plugins were found"
msgstr "देखें कौन से फ़ॉर्म प्लगइन मिले"

#: admin/assets/kanban/build/index.js:37
msgid ""
"No pipeline is set up yet. Deactivate and activate EntryVault once to create "
"the default one."
msgstr ""
"अभी कोई पाइपलाइन सेट नहीं है। डिफ़ॉल्ट पाइपलाइन बनाने के लिए EntryVault को एक बार "
"बंद करके फिर चालू करें।"

