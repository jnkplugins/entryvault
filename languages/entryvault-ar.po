msgstr "النوع"

#: admin/views/assistants.php:233
msgid "Assistants"
msgstr "المساعدات"

#: admin/views/assistants.php:238
msgid "Reads"
msgstr "قراءة"

#: admin/views/assistants.php:239
msgid "Changes entries"
msgstr "يغيّر الإدخالات"

#: admin/views/assistants.php:240
msgid "Sends email"
msgstr "يرسل بريدًا إلكترونيًا"

#: admin/views/assistants.php:249
