#: pro/licensorpro-client/licensorpro-client.php:750
msgid "Manage license"
msgstr "إدارة الترخيص"

#: pro/licensorpro-client/licensorpro-client.php:753
msgid "Renew license"
msgstr "تجديد الترخيص"

#: pro/licensorpro-client/licensorpro-client.php:754
msgid "Activate license"
msgstr "تفعيل الترخيص"

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:781
#, php-format
msgid ""
"<strong>%s Pro is on.</strong> Thank you! Every Pro tool is switched on for "
"this site, and updates come to your dashboard."
msgstr ""
"<strong>%s Pro مُفعّل.</strong> شكرًا لك! كل أدوات Pro تعمل على هذا الموقع، "
"والتحديثات تصل إلى لوحة التحكم."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:830
#, php-format
msgid ""
"<strong>%s Pro is installed, but no Pro license is active on this site.</"
"strong> Enter your license key to switch on the Pro tools."
msgstr ""
"<strong>%s Pro مثبّت، لكن لا يوجد ترخيص Pro نشط على هذا الموقع.</strong> أدخل "
"مفتاح الترخيص لتشغيل أدوات Pro."

#: pro/licensorpro-client/licensorpro-client.php:836
msgid "Enter license key"
msgstr "أدخل مفتاح الترخيص"

#: pro/licensorpro-client/licensorpro-client.php:839
msgid "Find your key in your account"
msgstr "تجد المفتاح في حسابك"

#: pro/licensorpro-client/licensorpro-client.php:865
msgid "Renew your license"
msgstr "جدّد ترخيصك"

#. translators: 1: plugin name, 2: expiry date, 3: lock date, 4: days left
#: pro/licensorpro-client/licensorpro-client.php:871
#, php-format
msgid ""
"<strong>Your %1$s Pro license expired on %2$s.</strong> Pro keeps working as "
"normal until %3$s (%4$d days left). Updates, including security fixes, and "
"email support have stopped. After %3$s, everything you already set up keeps "
"working and your visitors won't notice a thing, but the Pro tools in your "
"dashboard will lock."
msgstr ""
"<strong>انتهى ترخيص %1$s Pro في %2$s.</strong> يستمر Pro بالعمل كالمعتاد حتى "
"%3$s (بقي %4$d يومًا). توقفت التحديثات، ومنها إصلاحات الأمان، وتوقف الدعم عبر "
"البريد الإلكتروني. بعد %3$s يبقى كل ما أعددته يعمل ولن يلاحظ زوارك أي شيء، "
"لكن أدوات Pro في لوحة التحكم ستُقفل."

#. translators: 1: plugin name, 2: expiry date
#: pro/licensorpro-client/licensorpro-client.php:881
#, php-format
msgid ""
"<strong>%1$s Pro tools are locked because your license expired on %2$s.</"
"strong> Your site, and everything visitors see, still works. Renew to unlock "
"the Pro tools and get updates, including security fixes, again."
msgstr ""
"<strong>أدوات %1$s Pro مقفلة لأن ترخيصك انتهى في %2$s.</strong> موقعك وكل ما "
"يراه الزوار ما زال يعمل. جدّد الترخيص لفتح أدوات Pro والحصول على التحديثات "
"مجددًا، ومنها إصلاحات الأمان."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:889
#, php-format
msgid ""
"<strong>This site is no longer activated on your %s Pro license.</strong> "
"The Pro tools in your dashboard are locked until you activate it again. "
"Everything visitors see keeps working."
msgstr ""
"<strong>هذا الموقع لم يعد مُفعّلًا على ترخيص %s Pro.</strong> أدوات Pro في لوحة "
"التحكم مقفلة حتى تفعّله مجددًا. كل ما يراه الزوار يستمر بالعمل."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:896
#, php-format
msgid ""
"<strong>Your %s Pro license is no longer active.</strong> It was refunded or "
"cancelled, so the Pro tools in your dashboard are locked and updates have "
"stopped. Everything visitors see keeps working."
msgstr ""
"<strong>ترخيص %s Pro لم يعد نشطًا.</strong> تم استرداد المبلغ أو إلغاء "
"الاشتراك، لذا أُقفلت أدوات Pro في لوحة التحكم وتوقفت التحديثات. كل ما يراه "
"الزوار يستمر بالعمل."

#: pro/licensorpro-client/licensorpro-client.php:998
msgid "Please enter a license key."
msgstr "الرجاء إدخال مفتاح ترخيص."

#: pro/licensorpro-client/licensorpro-client.php:1010
#: pro/licensorpro-client/licensorpro-client.php:1069
msgid "License response failed signature verification."
msgstr "فشل التحقق من توقيع رد الترخيص."

#: pro/licensorpro-client/licensorpro-client.php:1052
msgid "No license key set."
msgstr "لم يتم تعيين مفتاح ترخيص."

#: pro/licensorpro-client/licensorpro-client.php:1184
msgid "Only deactivating temporarily"
msgstr "أعطّلها مؤقتًا فقط"

#: pro/licensorpro-client/licensorpro-client.php:1185
msgid "I could not work out how to use it"
msgstr "لم أعرف كيف أستخدمها"

#: pro/licensorpro-client/licensorpro-client.php:1186
msgid "It is missing a feature I need"
msgstr "تنقصها ميزة أحتاجها"

#: pro/licensorpro-client/licensorpro-client.php:1187
msgid "It did not work"
msgstr "لم تعمل"

#: pro/licensorpro-client/licensorpro-client.php:1188
msgid "It broke something on my site"
msgstr "تسببت في عطل في موقعي"

#: pro/licensorpro-client/licensorpro-client.php:1189
msgid "I found a better plugin"
msgstr "وجدت إضافة أفضل"

#: pro/licensorpro-client/licensorpro-client.php:1190
msgid "I no longer need it"
msgstr "لم أعد بحاجة إليها"

#: pro/licensorpro-client/licensorpro-client.php:1191
msgid "Something else"
msgstr "سبب آخر"

#. translators: %s: plugin name.
#: pro/licensorpro-client/licensorpro-client.php:1218
#, php-format
msgid "Before you turn %s off"
msgstr "قبل أن تعطّل %s"

#: pro/licensorpro-client/licensorpro-client.php:1222
msgid ""
"If you have a moment, what went wrong? It is the only way we hear about it."
msgstr "إن كان لديك دقيقة، ما الذي لم يعمل؟ هذه هي الطريقة الوحيدة لنعرف بذلك."

#: pro/licensorpro-client/licensorpro-client.php:1233
msgid "Anything else? (optional)"
msgstr "هل من شيء آخر؟ (اختياري)"

#: pro/licensorpro-client/licensorpro-client.php:1235
msgid ""
"Sends your answer, the plugin version and your site address. Nothing else, "
"and nothing from your site content."
msgstr ""
"يُرسل إجابتك وإصدار الإضافة وعنوان موقعك. لا شيء غير ذلك، ولا شيء من محتوى "
"موقعك."

#: pro/licensorpro-client/licensorpro-client.php:1239
msgid "Send and deactivate"
msgstr "أرسل وعطّل"

#: pro/licensorpro-client/licensorpro-client.php:1242
msgid "Skip and deactivate"
msgstr "تخطَّ وعطّل"

#: pro/licensorpro-client/licensorpro-client.php:1245 admin/views/tags.php:54
#: admin/assets/kanban/build/index.js:5 admin/assets/kanban/build/index.js:26
msgid "Cancel"
msgstr "إلغاء"

#: pro/licensorpro-client/licensorpro-client.php:1376
#: pro/licensorpro-client/licensorpro-client.php:1392
msgid "API URL not configured."
msgstr "لم يتم إعداد عنوان API URL."

#: pro/licensorpro-client/licensorpro-client.php:1411
msgid "Unexpected response from license server."
msgstr "رد غير متوقع من خادم التراخيص."

#. translators: %s: human-readable time difference, e.g. "3 hours".
#: pro/licensorpro-client/licensorpro-client.php:1736
#: includes/class-dates.php:65
#, php-format
msgid "in %s"
msgstr "خلال %s"

#. translators: %s: human-readable time difference, e.g. "3 hours".
#: pro/licensorpro-client/licensorpro-client.php:1737
#: includes/class-dates.php:73
#, php-format
msgid "%s ago"
msgstr "قبل %s"

#: pro/licensorpro-client/licensorpro-client.php:1762
#, php-format
msgid "%s License"
msgstr "ترخيص %s"

#: pro/licensorpro-client/licensorpro-client.php:1772
msgid ""
"This site was deactivated, so its seat is free for another site. Enter the "
"key again here to switch the Pro tools back on."
msgstr ""
"تم تعطيل هذا الموقع، لذا أصبح مقعده متاحًا لموقع آخر. أدخل المفتاح مجددًا هنا "
"لإعادة تشغيل أدوات Pro."

#: pro/licensorpro-client/licensorpro-client.php:1782
#: pro/licensorpro-client/licensorpro-client.php:1813
#: pro/licensorpro-client/licensorpro-client.php:1877
msgid "License key"
msgstr "مفتاح الترخيص"

#: pro/licensorpro-client/licensorpro-client.php:1783
msgid "Type"
msgstr "النوع"

#: pro/licensorpro-client/licensorpro-client.php:1785
msgid ""
"Free license: updates of the free version only. It does not switch on Pro."
msgstr "ترخيص Free: تحديثات النسخة المجانية فقط. لا يشغّل Pro."

#: pro/licensorpro-client/licensorpro-client.php:1786
msgid "Free license: updates arrive in your dashboard like any other plugin."
msgstr "ترخيص Free: تصل التحديثات إلى لوحة التحكم مثل أي إضافة أخرى."

#: pro/licensorpro-client/licensorpro-client.php:1788
#: pro/licensorpro-client/licensorpro-client.php:1845
msgid "Last checked"
msgstr "آخر فحص"

#: pro/licensorpro-client/licensorpro-client.php:1792
#: pro/licensorpro-client/licensorpro-client.php:1851
msgid "Check for updates now"
msgstr "تحقق من التحديثات الآن"

#: pro/licensorpro-client/licensorpro-client.php:1795
msgid "Bought Pro?"
msgstr "اشتريت Pro؟"

#: pro/licensorpro-client/licensorpro-client.php:1796
msgid ""
"Enter your Pro license key and Pro is installed over this version. "
"Everything you set up stays."
msgstr ""
"أدخل مفتاح ترخيص Pro وسيُثبَّت Pro فوق هذا الإصدار. كل ما أعددته يبقى كما هو."

#: pro/licensorpro-client/licensorpro-client.php:1798
msgid "Pro license key"
msgstr "مفتاح ترخيص Pro"

#: pro/licensorpro-client/licensorpro-client.php:1801
#: pro/licensorpro-client/licensorpro-client.php:1858
msgid "Install Pro now"
msgstr "ثبّت Pro الآن"

#: pro/licensorpro-client/licensorpro-client.php:1803
msgid ""
"Rather do it by hand? Download the Pro zip from your account and upload it "
"over this plugin."
msgstr ""
"تفضّل القيام بذلك يدويًا؟ نزّل ملف Pro المضغوط (zip) من حسابك وارفعه فوق هذه "
"الإضافة."

#: pro/licensorpro-client/licensorpro-client.php:1804
#: pro/licensorpro-client/licensorpro-client.php:1885
msgid "Go to your account"
msgstr "اذهب إلى حسابك"

#: pro/licensorpro-client/licensorpro-client.php:1816
msgid "active"
msgstr "نشط"

#. translators: %s: date the Pro tools lock
#: pro/licensorpro-client/licensorpro-client.php:1818
#, php-format
msgid "expired, Pro tools stay on until %s"
msgstr "منتهٍ، تبقى أدوات Pro تعمل حتى %s"

#: pro/licensorpro-client/licensorpro-client.php:1819
msgid "expired, Pro tools locked"
msgstr "منتهٍ، أدوات Pro مقفلة"

#: pro/licensorpro-client/licensorpro-client.php:1821
msgid "this site is not activated"
msgstr "هذا الموقع غير مُفعّل"

#: pro/licensorpro-client/licensorpro-client.php:1822
msgid "no longer active (refunded or cancelled)"
msgstr "لم يعد نشطًا (تم الاسترداد أو الإلغاء)"

#: pro/licensorpro-client/licensorpro-client.php:1824
#: admin/views/past-entries.php:91
#: admin/assets/kanban/build/index.js:5
msgid "Status"
msgstr "الحالة"

#: pro/licensorpro-client/licensorpro-client.php:1826
msgid "Renew"
msgstr "تجديد"

#: pro/licensorpro-client/licensorpro-client.php:1830
msgid "Offline mode"
msgstr "وضع عدم الاتصال"

#: pro/licensorpro-client/licensorpro-client.php:1832
#, php-format
msgid "cached license valid until %s"
msgstr "الترخيص المخزّن مؤقتًا صالح حتى %s"

#: pro/licensorpro-client/licensorpro-client.php:1837
msgctxt "update channel"
msgid "stable"
msgstr "مستقر"

#: pro/licensorpro-client/licensorpro-client.php:1838
msgctxt "update channel"
msgid "beta"
msgstr "بيتا"

#: pro/licensorpro-client/licensorpro-client.php:1839
msgctxt "update channel"
msgid "release candidate"
msgstr "إصدار مرشّح"

#: pro/licensorpro-client/licensorpro-client.php:1840
msgctxt "update channel"
msgid "development"
msgstr "تطوير"

#: pro/licensorpro-client/licensorpro-client.php:1842
msgid "Update channel"
msgstr "قناة التحديث"

#: pro/licensorpro-client/licensorpro-client.php:1843
msgid "Site limit"
msgstr "حد المواقع"

#: pro/licensorpro-client/licensorpro-client.php:1843
msgid "Unlimited"
msgstr "غير محدود"

#: pro/licensorpro-client/licensorpro-client.php:1844
msgid "Expires"
msgstr "ينتهي في"

#: pro/licensorpro-client/licensorpro-client.php:1844
msgid "Never"
msgstr "أبدًا"

#: pro/licensorpro-client/licensorpro-client.php:1849
msgid "Deactivate this site"
msgstr "تعطيل هذا الموقع"

#: pro/licensorpro-client/licensorpro-client.php:1856
msgid "This is the free version, running on your Pro license."
msgstr "هذه هي النسخة المجانية، تعمل على ترخيص Pro الخاص بك."

#: pro/licensorpro-client/licensorpro-client.php:1873
msgid ""
"Have a Pro license key? Enter it here to switch on the Pro tools. It "
"replaces the free license on this site."
msgstr ""
"لديك مفتاح ترخيص Pro؟ أدخله هنا لتشغيل أدوات Pro. سيحل محل الترخيص المجاني "
"على هذا الموقع."

#: pro/licensorpro-client/licensorpro-client.php:1874
msgid "Enter your license key to activate this site."
msgstr "أدخل مفتاح الترخيص لتفعيل هذا الموقع."

#: pro/licensorpro-client/licensorpro-client.php:1881
msgid "Activate"
msgstr "تفعيل"

#: pro/licensorpro-client/licensorpro-client.php:1884
msgid "Your key is in your purchase email and in your account."
msgstr "تجد مفتاحك في رسالة الشراء وفي حسابك."

#: pro/licensorpro-client/licensorpro-client.php:1892
msgid "Need a hand?"
msgstr "تحتاج مساعدة؟"

#: pro/licensorpro-client/licensorpro-client.php:1893
msgid "Contact support"
msgstr "تواصل مع الدعم"

#: pro/licensorpro-client/licensorpro-client.php:1900
msgid ""
"Every seat on this license is in use. Deactivate one of your other sites "
"from your account, then try again."
msgstr ""
"كل المواقع المسموح بها في هذا الترخيص مستخدمة. عطّل أحد مواقعك الأخرى من "
"حسابك ثم حاول مجددًا."

#: pro/licensorpro-client/licensorpro-client.php:1901
msgid ""
"This license has expired. Renewing it from your account reactivates this "
"site immediately. Your settings and data are untouched."
msgstr ""
"انتهت صلاحية هذا الترخيص. تجديده من حسابك يعيد تفعيل هذا الموقع فورًا، وتبقى "
"إعداداتك وبياناتك كما هي."

#: pro/licensorpro-client/licensorpro-client.php:1902
msgid ""
"That key was not recognised. Check for a missing character, or copy it again "
"from your purchase email."
msgstr ""
"لم نتعرّف على هذا المفتاح. تأكد من عدم نقص أي حرف، أو انسخه مجددًا من رسالة "
"الشراء."

#: pro/licensorpro-client/licensorpro-client.php:1903
msgid ""
"This key has been revoked. If you believe that is a mistake, reply to your "
"purchase email and we will sort it out."
msgstr ""
"تم إلغاء هذا المفتاح. إن كنت ترى أن ذلك خطأ، فردّ على رسالة الشراء وسنحلّ "
"الأمر."

#: pro/licensorpro-client/licensorpro-client.php:1904
msgid ""
"Could not reach the licensing server. Your site may be blocking outbound "
"requests. This is usually temporary, so try again in a minute."
msgstr ""
"تعذّر الوصول إلى خادم التراخيص. ربما يمنع موقعك الطلبات الخارجية. غالبًا يكون "
"ذلك مؤقتًا، فحاول مجددًا بعد دقيقة."

#: pro/licensorpro-client/licensorpro-client.php:1905
msgid "Too many attempts in a short window. Wait a minute and try again."
msgstr "محاولات كثيرة خلال وقت قصير. انتظر دقيقة ثم حاول مجددًا."

#: pro/licensorpro-client/licensorpro-client.php:1906
msgid ""
"The licensing server had a problem on its side. Your key was not rejected. "
"Try again in a few minutes, and if it keeps happening, reply to your "
"purchase email."
msgstr ""
"حدثت مشكلة في خادم التراخيص من جهته، ولم يُرفض مفتاحك. حاول مجددًا بعد بضع "
"دقائق، وإن تكرر ذلك فردّ على رسالة الشراء."

#: pro/licensorpro-client/licensorpro-client.php:1907
msgid "Enter your license key first."
msgstr "أدخل مفتاح الترخيص أولًا."

#: pro/licensorpro-client/licensorpro-client.php:1908
msgid "Installing Pro. This takes a few seconds, keep this page open…"
msgstr "جارٍ تثبيت Pro. يستغرق ذلك بضع ثوانٍ، أبقِ هذه الصفحة مفتوحة…"

#: pro/licensorpro-client/licensorpro-client.php:1909
msgid "Reloading to switch on the Pro tools…"
msgstr "جارٍ إعادة التحميل لتشغيل أدوات Pro…"

#: pro/licensorpro-client/licensorpro-client.php:1910
msgid "Reload now"
msgstr "أعد التحميل الآن"

#: pro/licensorpro-client/licensorpro-client.php:1911
msgid ""
"Could not reach the licensing server. Check your connection and try again."
msgstr "تعذّر الوصول إلى خادم التراخيص. تحقق من اتصالك وحاول مجددًا."

#: pro/licensorpro-client/licensorpro-client.php:1912
msgid ""
"Deactivate this license on this site? Premium features switch off here and "
"the seat is freed for another site."
msgstr ""
"هل تريد تعطيل هذا الترخيص على هذا الموقع؟ ستتوقف الميزات المميزة هنا ويصبح "
"المكان متاحًا لموقع آخر."

#: pro/licensorpro-client/licensorpro-client.php:1913
#: includes/class-plugin.php:368
msgid "Done."
msgstr "تم."

#: pro/licensorpro-client/licensorpro-client.php:1914
msgid "Deactivated."
msgstr "تم التعطيل."

#: pro/licensorpro-client/licensorpro-client.php:1915
msgid "Checked."
msgstr "تم الفحص."

#: pro/licensorpro-client/licensorpro-client.php:2103
msgid "Only someone who may install plugins on this site can install Pro."
msgstr "فقط من يملك صلاحية تثبيت الإضافات على هذا الموقع يمكنه تثبيت Pro."

#: pro/licensorpro-client/licensorpro-client.php:2116
msgid ""
"That is a free license key, so it keeps this free version updated. Pro needs "
"the key from your purchase email."
msgstr ""
"هذا مفتاح ترخيص مجاني، لذا يبقي هذه النسخة المجانية محدّثة. يحتاج Pro إلى "
"المفتاح الموجود في رسالة الشراء."

#. translators: %s: URL of the customer account
#: pro/licensorpro-client/licensorpro-client.php:2121
#, php-format
msgid ""
"Your key is active. Download the Pro zip from your account (%s) and upload "
"it over this plugin instead."
msgstr ""
"مفتاحك نشط. نزّل ملف Pro المضغوط من حسابك (%s) وارفعه فوق هذه الإضافة بدلًا من "
"ذلك."

#: pro/licensorpro-client/licensorpro-client.php:2125
msgid "This site does not allow installing plugins from the dashboard."
msgstr "هذا الموقع لا يسمح بتثبيت الإضافات من لوحة التحكم."

#: pro/licensorpro-client/licensorpro-client.php:2129
msgid "The Pro download could not be fetched for this key."
msgstr "تعذّر جلب تنزيل Pro لهذا المفتاح."

#: pro/licensorpro-client/licensorpro-client.php:2137
msgid "This site asks for FTP details to install plugins."
msgstr "يطلب هذا الموقع بيانات FTP لتثبيت الإضافات."

#: pro/licensorpro-client/licensorpro-client.php:2172
msgid "Installing Pro did not finish."
msgstr "لم يكتمل تثبيت Pro."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:2177
#, php-format
msgid "%s Pro is installed and your license is active. Reloading…"
msgstr "تم تثبيت %s Pro وترخيصك نشط. جارٍ إعادة التحميل…"

#: pro/licensorpro-client/licensorpro-client.php:2187
msgid "License activated."
msgstr "تم تفعيل الترخيص."

#: pro/licensorpro-client/licensorpro-client.php:2202
msgid "Site deactivated."
msgstr "تم تعطيل الموقع."

#: pro/licensorpro-client/licensorpro-client.php:2213
